<div id="page">
    <div id="contents">
        <h1>Travel</h1>
        <ul id="rooms">
            {{#each trips}}
            <li>
                <img src="/images/{{this.image}}" alt="{{this.name}}">
                
                <div class="details-wrapper">
                    <h2><a href="/travel">{{this.name}}</a></h2>
                    <h6>{{this.resort}}</h6>
                    {{{this.description}}}
                    <span class="rate">${{this.perPerson}} Per Person</span>
                </div>
            </li>
            {{/each}}
        </ul>
    </div>
</div>